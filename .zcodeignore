# Environment variables & secrets
.env
.env.*
*.key
secrets*.json

# Shared AI config (contains the publisher's API key)
shared-ai.config.json

# Editor private config & OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.zcode/
.DS_Store
Thumbs.db

# Logs & temp files
logs/
*.log
npm-debug.log*
tmp/
.cache/

# Local code-review artifacts
bug.txt

