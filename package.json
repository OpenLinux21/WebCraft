{
  "name": "webcraft",
  "version": "0.1.0",
  "description": "A privacy-first, fully static learning platform for web design and front-end programming.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "serve:shared": "node scripts/serve-shared.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@material/web": "^2.5.0",
    "astro": "^5.18.2",
    "lenis": "^1.3.26",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^6.0.4",
    "archiver": "^7.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
