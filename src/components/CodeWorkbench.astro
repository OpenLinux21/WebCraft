---
import { serializeJsonScript } from '@/lib/utils/json-script';
import { createTranslator } from '@/lib/i18n/core';
import type { AppLocale } from '@/lib/i18n/core';
import type { CodeFiles } from '@/lib/courses/code-files';
import { LIVE_PREVIEW_OPTIONS } from '@/lib/storage/settings';
import '@/styles/workbench.css';

interface Props {
  locale: AppLocale;
  /** Storage key for autosaved drafts (lesson id or `playground`). */
  draftKey: string;
  /** Unique model-URI base, e.g. `lesson-01-html-doc-structure`. */
  instanceId: string;
  /** Starter code shown when no draft exists. */
  initial: CodeFiles;
}

interface TabDefinition {
  lang: 'html' | 'css' | 'javascript';
  key: 'workbench.tabHtml' | 'workbench.tabCss' | 'workbench.tabJs';
}

const TABS: readonly TabDefinition[] = [
  { lang: 'html', key: 'workbench.tabHtml' },
  { lang: 'css', key: 'workbench.tabCss' },
  { lang: 'javascript', key: 'workbench.tabJs' },
];

const { locale, draftKey, instanceId, initial } = Astro.props;
const t = createTranslator(locale);
---

<section
  class="workbench"
  data-workbench
  data-draft-key={draftKey}
  data-locale={locale}
  data-instance-id={instanceId}
>
  <script type="application/json" data-initial set:html={serializeJsonScript(initial)} />
  <div class="workbench__layout">
    <div class="workbench__editor-pane">
      <div class="workbench__toolbar">
        <div class="workbench__tabs" role="tablist" aria-label={t.t('workbench.editorLabel')}>
          {TABS.map((tab) => (
            <button
              type="button"
              class="workbench__tab"
              role="tab"
              data-tab={tab.lang}
              aria-selected={tab.lang === 'html' ? 'true' : 'false'}
            >
              {t.t(tab.key)}
            </button>
          ))}
        </div>
        <div class="workbench__actions">
          <md-filled-button type="button" data-action="run">
            {t.t('workbench.run')}
          </md-filled-button>
          <md-outlined-button type="button" data-action="format">
            {t.t('workbench.format')}
          </md-outlined-button>
          <md-outlined-button type="button" data-action="copy">
            {t.t('common.copy')}
          </md-outlined-button>
          <md-text-button type="button" data-action="reset">
            {t.t('workbench.reset')}
          </md-text-button>
        </div>
      </div>

      <div
        class="workbench__editor"
        data-editor
        id="workbench-editor-panel"
        role="tabpanel"
        aria-label={t.t('workbench.editorLabel')}
        tabindex="0"
      ></div>

      <div class="workbench__statusbar">
        <label class="workbench__autorun">
          <span>{t.t('workbench.autoRun')}</span>
          <md-outlined-select data-autorun>
            {LIVE_PREVIEW_OPTIONS.map((ms) => (
              <md-select-option value={String(ms)}>
                {ms === 0
                  ? t.t('workbench.autoRunOff')
                  : ms === 500
                    ? t.t('workbench.autoRunFast')
                    : ms === 1000
                      ? t.t('workbench.autoRunNormal')
                      : t.t('workbench.autoRunSlow')}
              </md-select-option>
            ))}
          </md-outlined-select>
        </label>
        <span class="workbench__hint">{t.t('workbench.runShortcutHint')}</span>
      </div>
    </div>

    <div class="workbench__preview-pane">
      <div class="workbench__pane-title">{t.t('workbench.previewLabel')}</div>
      <iframe
        class="workbench__preview"
        data-preview
        sandbox="allow-scripts"
        title={t.t('workbench.previewAria')}
      ></iframe>
    </div>
  </div>

  <div class="console-panel" data-console>
    <div class="console-panel__header">
      <h3>{t.t('workbench.consoleTitle')}</h3>
      <md-text-button type="button" data-console-clear>
        {t.t('workbench.consoleClear')}
      </md-text-button>
    </div>
    <ol
      class="console-panel__list"
      data-console-list
      aria-live="polite"
      aria-relevant="additions"
    ></ol>
    <p class="console-panel__empty" data-console-empty>
      {t.t('workbench.consoleEmpty')}
    </p>
  </div>
</section>

<script>
  import '@/components/material/register';
  import type { MdOutlinedSelect } from '@/components/material/register';
  import type { CodeFiles } from '@/lib/courses/code-files';
  import type { CodeDraft } from '@/lib/courses/types';
  import { createTranslator, isAppLocale } from '@/lib/i18n/core';
  import { generateToken } from '@/lib/utils/id';
  import { debounce } from '@/lib/utils/debounce';
  import { createConsolePanel } from '@/lib/preview/console-panel';
  import { createPreviewController } from '@/lib/preview/controller';
  import { createDraftRepo } from '@/lib/storage/repos/drafts';
  import { getStorage } from '@/lib/storage/storage';
  import { setSharedFiles } from '@/lib/editor/registry';
  import {
    loadPreviewSettings,
    savePreviewSettings,
    type LivePreviewMs,
  } from '@/lib/storage/settings';
  import { showToast } from '@/lib/ui/toast';
  import { onPageLoad, registerCleanup } from '@/lib/ui/lifecycle';
  import type { EditorModels, EditorViewState, MonacoWorkbenchApi } from '@/lib/editor/monaco';

  type Lang = 'html' | 'css' | 'javascript';

  const isLang = (value: string): value is Lang =>
    value === 'html' || value === 'css' || value === 'javascript';

  function asCodeFiles(value: unknown): CodeFiles {
    const record = (value ?? {}) as Record<string, unknown>;
    const str = (key: string): string => {
      const v = record[key];
      return typeof v === 'string' ? v : '';
    };
    return { html: str('html'), css: str('css'), js: str('js') };
  }

  function filesFromModels(models: EditorModels): CodeFiles {
    return {
      html: models.html.getValue(),
      css: models.css.getValue(),
      js: models.javascript.getValue(),
    };
  }

  function setModels(models: EditorModels, files: CodeFiles): void {
    models.html.setValue(files.html);
    models.css.setValue(files.css);
    models.javascript.setValue(files.js);
  }

  async function initWorkbench(root: HTMLElement, monacoModule: MonacoWorkbenchApi): Promise<void> {
    const { createCodeEditor, createModels, disposeModels } = monacoModule;
    const localeRaw: unknown = root.dataset.locale;
    // ?task=<id> re-keys the workspace BEFORE anything else reads these:
    // module scripts run before inline body scripts, so the URL is the
    // single source of truth (the inline banner script mirrors it).
    const taskParam = new URLSearchParams(window.location.search).get('task');
    const taskId =
      taskParam && /^[0-9a-f]{4,32}$/i.test(taskParam) ? taskParam.toLowerCase() : null;
    const draftKey = taskId ? `task-${taskId}` : (root.dataset.draftKey ?? '');
    const instanceId = taskId ? `task-${taskId}` : (root.dataset.instanceId ?? 'workbench');
    if (taskId) {
      root.dataset.draftKey = draftKey;
      root.dataset.instanceId = instanceId;
    }
    if (!isAppLocale(localeRaw)) return;
    const t = createTranslator(localeRaw);

    const payload = root.querySelector<HTMLScriptElement>('[data-initial]');
    let initial: CodeFiles = { html: '', css: '', js: '' };
    try {
      initial = asCodeFiles(JSON.parse(payload?.textContent ?? '{}'));
    } catch {
      // Malformed payload: fall back to empty files.
    }

    // Editor + models
    const editorEl = root.querySelector<HTMLElement>('[data-editor]');
    if (!editorEl) return;
    // Storage failures (private mode, quota) must not leave the workbench
    // dead: fall back to the starter code and keep the session working.
    let drafts: ReturnType<typeof createDraftRepo> | null = null;
    let savedDraft: CodeDraft | undefined;
    try {
      const storage = await getStorage();
      // A client-side navigation may have swapped the page away while
      // storage was opening; bail before creating any models so the fresh
      // page can build its own editor without duplicate-URI conflicts.
      if (!root.isConnected) return;
      drafts = createDraftRepo(storage);
      savedDraft = draftKey ? await drafts.get(draftKey) : undefined;
    } catch {
      drafts = null;
    }
    const filesAtStart = savedDraft
      ? { html: savedDraft.html, css: savedDraft.css, js: savedDraft.js }
      : initial;
    if (savedDraft) showToast(t.t('workbench.draftRestored'));

    const saveDraft = (files: CodeFiles): void => {
      drafts?.set(draftKey, files).catch(() => {
        // Draft persistence is best-effort; the editor keeps working.
      });
    };

    const models = createModels(
      { html: filesAtStart.html, css: filesAtStart.css, javascript: filesAtStart.js },
      instanceId,
    );
    const editorInstance = createCodeEditor({
      container: editorEl,
      language: 'html',
      value: models.html.getValue(),
    });

    // Tab switching keeps per-language view state.
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const viewStates = new Map<Lang, EditorViewState>();
    let activeLang: Lang = 'html';

    const switchTo = (lang: Lang): void => {
      if (lang === activeLang) return;
      viewStates.set(activeLang, editorInstance.editor.saveViewState());
      activeLang = lang;
      editorInstance.editor.setModel(models[lang]);
      const state = viewStates.get(lang);
      if (state) editorInstance.editor.restoreViewState(state);
      editorInstance.editor.focus();
      for (const tab of tabs) {
        tab.setAttribute(
          'aria-selected',
          isLang(tab.dataset.tab ?? '') && tab.dataset.tab === lang ? 'true' : 'false',
        );
      }
    };
    for (const tab of tabs) {
      const lang = tab.dataset.tab ?? '';
      if (isLang(lang)) tab.addEventListener('click', () => switchTo(lang));
    }
    // WAI-ARIA tabs: arrow keys move between tabs, Home/End jump to the ends.
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const keyboardEvent = event as KeyboardEvent;
      const currentIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      let next = -1;
      if (keyboardEvent.key === 'ArrowRight') next = (currentIndex + 1) % tabs.length;
      else if (keyboardEvent.key === 'ArrowLeft')
        next = (currentIndex - 1 + tabs.length) % tabs.length;
      else if (keyboardEvent.key === 'Home') next = 0;
      else if (keyboardEvent.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      keyboardEvent.preventDefault();
      const nextTab = tabs[next];
      const nextLang = nextTab?.dataset.tab ?? '';
      if (isLang(nextLang)) {
        switchTo(nextLang);
        nextTab?.focus();
      }
    });

    // Preview + console
    const iframe = root.querySelector<HTMLIFrameElement>('[data-preview]');
    const consoleRoot = root.querySelector<HTMLElement>('[data-console]');
    if (!iframe || !consoleRoot) return;
    const consolePanel = createConsolePanel(consoleRoot, {
      emptyText: t.t('workbench.consoleEmpty'),
    });
    const preview = createPreviewController(iframe, generateToken(), (message) => {
      switch (message.kind) {
        case 'console':
          consolePanel.add(message.level, message.text);
          break;
        case 'error':
          consolePanel.add(
            'exception',
            `${message.message}${message.line !== null ? ` (line ${message.line})` : ''}`,
          );
          break;
        case 'unhandledrejection':
          consolePanel.add('exception', `Unhandled rejection: ${message.message}`);
          break;
        case 'ready':
          break;
      }
    });

    const run = (): void => {
      consolePanel.beginRun();
      const files = filesFromModels(models);
      setSharedFiles(draftKey, files);
      preview.run(files);
    };
    run();

    // Autosave (debounced) + live preview on every content change.
    const persistDraft = draftKey ? debounce(() => saveDraft(filesFromModels(models)), 800) : null;
    editorInstance.onContentChange(() => {
      setSharedFiles(draftKey, filesFromModels(models));
      persistDraft?.();
      scheduleLivePreview();
    });

    // Live preview schedule (0 = off), shared with the settings page.
    let liveTimer: ReturnType<typeof setTimeout> | null = null;
    const scheduleLivePreview = (): void => {
      if (liveTimer !== null) clearTimeout(liveTimer);
      const delay = loadPreviewSettings().livePreviewMs;
      if (delay === 0) return;
      liveTimer = setTimeout(run, delay);
    };

    // Toolbar
    const button = (name: string): HTMLElement | null =>
      root.querySelector<HTMLElement>(`[data-action="${name}"]`);
    button('run')?.addEventListener('click', run);
    button('format')?.addEventListener('click', () => editorInstance.format());
    button('copy')?.addEventListener('click', () => {
      const activeModel = models[activeLang];
      void navigator.clipboard
        .writeText(activeModel.getValue())
        .then(() => showToast(t.t('common.copied')))
        .catch((error: unknown) =>
          showToast(
            t.t('errors.copyFailed', {
              reason: error instanceof Error ? error.message : String(error),
            }),
          ),
        );
    });
    button('reset')?.addEventListener('click', () => {
      if (!window.confirm(t.t('workbench.resetConfirm'))) return;
      setModels(models, initial);
      if (draftKey) saveDraft(initial);
      run();
      showToast(t.t('workbench.resetDone'));
    });

    editorInstance.addRunCommand(run);

    // Live-preview interval selector (also updates the global default).
    const autorunSelect = root.querySelector<MdOutlinedSelect>('[data-autorun]');
    if (autorunSelect) {
      autorunSelect.value = String(loadPreviewSettings().livePreviewMs);
      autorunSelect.addEventListener('change', () => {
        const ms = Number(autorunSelect.value) as LivePreviewMs;
        savePreviewSettings({ livePreviewMs: ms });
        if (ms === 0 && liveTimer !== null) {
          clearTimeout(liveTimer);
          liveTimer = null;
        } else if (ms > 0) {
          run();
        }
      });
    }

    // Reference-solution loading (dispatched by the exercise panel).
    const loadSolution = (event: Event): void => {
      const detail = (event as CustomEvent<unknown>).detail;
      if (!window.confirm(t.t('lesson.loadSolutionConfirm'))) return;
      const files = asCodeFiles(detail);
      setModels(models, files);
      if (draftKey) saveDraft(files);
      run();
    };
    window.addEventListener('webcraft:load-code', loadSolution);

    // Cleanup on page exit: `pagehide` covers full unloads and bfcache
    // restores, while the shared lifecycle flushes the same teardown on
    // client-side swaps (which never fire pagehide). Guarded so running
    // both paths cannot double-dispose the editor.
    let disposed = false;
    const disposeAll = (): void => {
      if (disposed) return;
      disposed = true;
      window.removeEventListener('webcraft:load-code', loadSolution);
      persistDraft?.cancel();
      if (liveTimer !== null) clearTimeout(liveTimer);
      preview.dispose();
      editorInstance.dispose();
      disposeModels(models);
    };
    window.addEventListener('pagehide', disposeAll, { once: true });
    registerCleanup(disposeAll);
  }

  async function initWorkbenches(): Promise<void> {
    const roots = document.querySelectorAll<HTMLElement>('[data-workbench]');
    if (roots.length === 0) return;
    const monacoModule = await import('@/lib/editor/monaco');
    for (const root of roots) {
      if (!root.isConnected) continue; // swapped away mid-import
      await initWorkbench(root, monacoModule);
    }
  }

  onPageLoad(() => void initWorkbenches());
</script>
