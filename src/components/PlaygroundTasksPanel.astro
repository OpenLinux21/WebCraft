---
/**
 * Playground challenges panel: built-in starter tasks (offline) plus tasks
 * generated by the AI tutor (via the webcraft:new-task event).
 */
import '@/components/material/register';
import { createTranslator } from '@/lib/i18n/core';
import type { AppLocale } from '@/lib/i18n/core';

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
---

<section
  class="card tasks-panel"
  aria-labelledby="tasks-title"
  data-tasks-panel
  data-locale={locale}
>
  <div class="tasks-panel__head">
    <h2 id="tasks-title">{t.t('playground.tasksTitle')}</h2>
    <div class="tasks-panel__actions">
      <md-outlined-button type="button" data-tasks-builtin>
        {t.t('playground.newBuiltin')}
      </md-outlined-button>
      <md-filled-tonal-button type="button" data-tasks-generate>
        {t.t('playground.newTask')}
      </md-filled-tonal-button>
    </div>
  </div>

  <ul class="tasks-panel__list" data-tasks-list></ul>
  <p class="form-hint" data-tasks-empty>
    {t.t('playground.noTasks')}
  </p>
</section>

<script>
  import '@/components/material/register';
  import { createTranslator, isAppLocale } from '@/lib/i18n/core';
  import { getStorage } from '@/lib/storage/storage';
  import { createPlaygroundRepo, type PlaygroundRepo } from '@/lib/storage/repos/playground';

  interface ChallengeDraft {
    title: string;
    task: string;
    difficulty: 'beginner' | 'intermediate';
  }

  function isChallengeDraft(value: unknown): value is ChallengeDraft {
    if (typeof value !== 'object' || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record['title'] === 'string' &&
      typeof record['task'] === 'string' &&
      (record['difficulty'] === 'beginner' || record['difficulty'] === 'intermediate')
    );
  }

  async function initTasksPanel(): Promise<void> {
    const root = document.querySelector<HTMLElement>('[data-tasks-panel]');
    if (!root) return;
    const localeRaw: unknown = root.dataset.locale;
    if (!isAppLocale(localeRaw)) return;
    const t = createTranslator(localeRaw);
    const panel: HTMLElement = root;
    const repo: PlaygroundRepo = createPlaygroundRepo(await getStorage());
    const list = panel.querySelector<HTMLElement>('[data-tasks-list]');
    const emptyHint = panel.querySelector<HTMLElement>('[data-tasks-empty]');
    if (!list || !emptyHint) return;

    let builtinCursor = 0;
    const BUILTIN_KEYS = ['t1', 't2', 't3'] as const;

    const sync = async (): Promise<void> => {
      const tasks = await repo.list();
      list.replaceChildren();
      emptyHint.hidden = tasks.length > 0;
      for (const { id, task } of tasks) {
        const item = document.createElement('li');
        item.className = 'tasks-panel__item';
        item.dataset.status = task.status;

        const head = document.createElement('div');
        head.className = 'tasks-panel__item-head';
        const title = document.createElement('strong');
        title.textContent = task.title;
        const chips = document.createElement('span');
        chips.className = 'tasks-panel__chips';
        const source = document.createElement('span');
        source.className = 'tasks-panel__chip';
        source.textContent = t.t(task.source === 'ai' ? 'playground.fromAi' : 'playground.builtin');
        const difficulty = document.createElement('span');
        difficulty.className = 'tasks-panel__chip';
        difficulty.textContent = t.t(`courses.difficulty.${task.difficulty}`);
        if (task.status === 'completed') {
          const done = document.createElement('span');
          done.className = 'tasks-panel__chip tasks-panel__chip--done';
          done.textContent = t.t('playground.taskCompletedLabel');
          chips.appendChild(done);
        }
        chips.appendChild(source);
        chips.appendChild(difficulty);
        head.appendChild(title);
        head.appendChild(chips);

        const body = document.createElement('p');
        body.className = 'tasks-panel__task';
        body.textContent = task.task;

        const actions = document.createElement('div');
        actions.className = 'tasks-panel__item-actions';
        const toggle = document.createElement('md-text-button');
        toggle.setAttribute('type', 'button');
        toggle.textContent = t.t(
          task.status === 'completed' ? 'playground.taskReopen' : 'playground.taskComplete',
        );
        toggle.addEventListener('click', () => {
          void repo.setStatus(id, task.status === 'completed' ? 'active' : 'completed').then(sync);
        });
        const remove = document.createElement('md-text-button');
        remove.setAttribute('type', 'button');
        remove.textContent = t.t('common.delete');
        remove.addEventListener('click', () => {
          if (!window.confirm(t.t('playground.deleteTaskConfirm'))) return;
          void repo.remove(id).then(sync);
        });
        actions.appendChild(toggle);
        actions.appendChild(remove);

        item.appendChild(head);
        item.appendChild(body);
        item.appendChild(actions);
        list.appendChild(item);
      }
    };

    const addBuiltin = (): void => {
      const key = BUILTIN_KEYS[builtinCursor % BUILTIN_KEYS.length] ?? 't1';
      builtinCursor += 1;
      void repo
        .add({
          title: t.t(`playground.builtinTasks.${key}Title`),
          task: t.t(`playground.builtinTasks.${key}Task`),
          difficulty: 'beginner',
          source: 'builtin',
        })
        .then(sync);
    };

    panel.querySelector<HTMLElement>('[data-tasks-builtin]')?.addEventListener('click', addBuiltin);
    panel.querySelector<HTMLElement>('[data-tasks-generate]')?.addEventListener('click', () => {
      // The AI panel listens for this and runs its "challenge" mode.
      window.dispatchEvent(new CustomEvent('webcraft:generate-challenge'));
    });

    window.addEventListener('webcraft:new-task', (event) => {
      const detail = (event as CustomEvent<unknown>).detail;
      if (!isChallengeDraft(detail)) return;
      void repo.add({ ...detail, source: 'ai' }).then(sync);
    });

    await sync();
  }

  void initTasksPanel();
</script>

<style>
  .tasks-panel {
    display: flex;
    flex-direction: column;
    gap: var(--md-sys-spacing-4);
  }

  .tasks-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--md-sys-spacing-3);
  }

  .tasks-panel__head h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .tasks-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-2);
  }

  .tasks-panel__list {
    display: grid;
    gap: var(--md-sys-spacing-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tasks-panel__item {
    padding: var(--md-sys-spacing-4);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-md);
    background-color: var(--md-sys-color-surface-container-lowest);
  }

  .tasks-panel__item[data-status='completed'] {
    opacity: 0.75;
  }

  .tasks-panel__item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--md-sys-spacing-2);
  }

  .tasks-panel__chips {
    display: inline-flex;
    gap: var(--md-sys-spacing-2);
  }

  .tasks-panel__chip {
    padding: 0.1rem 0.6rem;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .tasks-panel__chip--done {
    background-color: var(--md-sys-color-success-container);
    color: var(--md-sys-color-on-success-container);
  }

  .tasks-panel__task {
    margin-block: var(--md-sys-spacing-2);
    font-size: 0.95rem;
  }

  .tasks-panel__item-actions {
    display: flex;
    gap: var(--md-sys-spacing-2);
  }

  [data-tasks-empty][hidden] {
    display: none;
  }
</style>
