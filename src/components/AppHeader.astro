---
import { createTranslator, getDictionary } from '@/lib/i18n/core';
import type { AppLocale, MessageKey } from '@/lib/i18n/core';
import {
  coursesPath,
  homePath,
  playgroundPath,
  relativeHref,
  settingsPath,
  swapLocaleSegment,
} from '@/lib/routes';
import '@/styles/layout.css';

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
const from = Astro.url.pathname;
const otherLocale: AppLocale = locale === 'en' ? 'zh-CN' : 'en';

const navItems: ReadonlyArray<{ key: MessageKey; path: string }> = [
  { key: 'nav.home', path: homePath(locale) },
  { key: 'nav.courses', path: coursesPath(locale) },
  { key: 'nav.playground', path: playgroundPath(locale) },
  { key: 'nav.settings', path: settingsPath(locale) },
];
---

<header class="app-header">
  <div class="app-header__inner">
    <a class="app-header__brand" href={relativeHref(homePath(locale), from)}>
      Web<span>Craft</span>
    </a>

    <nav class="app-nav" aria-label={t.t('a11y.mainNav')}>
      {navItems.map((item) => {
        const home = homePath(locale);
        const isCurrent = item.path === home ? from === home : from.startsWith(item.path);
        return (
          <a
            class="app-nav__link"
            href={relativeHref(item.path, from)}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {t.t(item.key)}
          </a>
        );
      })}
    </nav>

    <div class="app-header__actions">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label={t.t('theme.toggleLabel')}
      >
        <svg
          class="theme-icon theme-icon--light"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 18a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1ZM2 12a1 1 0 0 1 1-1h2a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1Zm17 0a1 1 0 0 1 1-1h2a1 1 0 1 1 0 2h-2a1 1 0 0 1-1-1ZM4.2 4.2a1 1 0 0 1 1.4 0l1.5 1.4a1 1 0 0 1-1.4 1.5L4.2 5.6a1 1 0 0 1 0-1.4Zm12.7 12.7a1 1 0 0 1 1.4 0l1.5 1.4a1 1 0 0 1-1.4 1.5l-1.5-1.4a1 1 0 0 1 0-1.5Zm1.4-12.7a1 1 0 0 1 0 1.4l-1.4 1.5a1 1 0 0 1-1.5-1.4l1.4-1.5a1 1 0 0 1 1.5 0ZM5.6 16.9a1 1 0 0 1 0 1.4l-1.4 1.5a1 1 0 0 1-1.5-1.4l1.5-1.5a1 1 0 0 1 1.4 0Z" />
        </svg>
        <svg
          class="theme-icon theme-icon--dark"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12.3 2a10 10 0 1 0 9.7 12.3A8 8 0 0 1 12.3 2Z" />
        </svg>
        <svg
          class="theme-icon theme-icon--system"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6v2h3a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h3v-2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v9h16V6H4Z" />
        </svg>
      </button>

      <a
        class="lang-switch"
        href={relativeHref(swapLocaleSegment(from, locale, otherLocale), from)}
        hreflang={otherLocale}
        aria-label={t.t('a11y.languageSwitch')}
      >
        {getDictionary(otherLocale).common.languageNativeName}
      </a>
    </div>
  </div>
</header>

<script>
  import {
    getResolvedTheme,
    getThemeSetting,
    initTheme,
    setThemeSetting,
    type ThemeSetting,
  } from '@/lib/theme/theme';

  initTheme();

  const ORDER: readonly ThemeSetting[] = ['light', 'dark', 'system'];
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    const sync = (): void => {
      button.dataset.setting = getThemeSetting();
      button.dataset.mode = getResolvedTheme();
    };
    sync();
    document.addEventListener('webcraft:theme-change', sync);
    button.addEventListener('click', () => {
      const current = getThemeSetting();
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length] ?? 'system';
      setThemeSetting(next);
    });
  }
</script>
