---
import '@/components/material/register';
import { serializeJsonScript } from '@/lib/utils/json-script';
import { createTranslator } from '@/lib/i18n/core';
import type { AppLocale } from '@/lib/i18n/core';

interface Props {
  locale: AppLocale;
  task: string;
  hints: string[];
  solution: { html: string; css: string; js: string };
}

const { locale, task, hints, solution } = Astro.props;
const t = createTranslator(locale);
const hasSolution = [solution.html, solution.css, solution.js].some((code) => code.trim() !== '');
---

<section class="exercise card" aria-labelledby="exercise-title">
  <h2 id="exercise-title">{t.t('lesson.exercise')}</h2>
  <p class="exercise__task">{task}</p>

  {hints.length > 0 && (
    <div class="exercise__hints" data-hints>
      {hints.map((hint, index) => (
        <details class="exercise__hint" data-hint hidden={index > 0}>
          <summary>{t.t('lesson.showHint', { n: index + 1 })}</summary>
          <p>{hint}</p>
        </details>
      ))}
    </div>
  )}

  {hasSolution && (
    <details class="exercise__solution">
      <summary>{t.t('lesson.solution')}</summary>
      {solution.html && <pre><code>{solution.html}</code></pre>}
      {solution.css && <pre><code>{solution.css}</code></pre>}
      {solution.js && <pre><code>{solution.js}</code></pre>}
      <md-outlined-button type="button" data-load-solution>
        {t.t('lesson.loadSolution')}
      </md-outlined-button>
      <script
        type="application/json"
        data-solution-payload
        set:html={serializeJsonScript(solution)}
      />
    </details>
  )}
</section>

<script>
  // Progressive hints: opening a hint unlocks the next one.
  document.querySelectorAll<HTMLElement>('[data-hints]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLDetailsElement>('details[data-hint]')];
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        const next = items[items.indexOf(item) + 1];
        if (next) next.hidden = false;
      });
    });
  });

  // Ask every workbench on the page to load the reference solution.
  document.querySelectorAll<HTMLElement>('[data-load-solution]').forEach((button) => {
    const root = button.closest<HTMLElement>('.exercise');
    const payload = root?.querySelector<HTMLScriptElement>('[data-solution-payload]');
    button.addEventListener('click', () => {
      if (!payload) return;
      let solution: unknown = {};
      try {
        solution = JSON.parse(payload.textContent ?? '{}');
      } catch {
        return;
      }
      window.dispatchEvent(new CustomEvent('webcraft:load-code', { detail: solution }));
    });
  });
</script>
