---
import { createTranslator } from '@/lib/i18n/core';
import type { AppLocale } from '@/lib/i18n/core';

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
---

<footer class="app-footer">
  <div class="app-footer__inner">
    <p>{t.t('footer.privacyNote')}</p>
    <p>
      © {new Date().getFullYear()} WebCraft · {t.t('footer.openSource')}
    </p>
    <p class="app-footer__meta">
      <span class="app-footer__prompt" aria-hidden="true">$ exit 0</span>
      <a class="app-footer__top" href="#main-content">
        {t.t('footer.backToTop')} <span aria-hidden="true">↑</span>
      </a>
    </p>
  </div>
</footer>
