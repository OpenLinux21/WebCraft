---
/**
 * 404: a terminal that tried to open a page that isn't there. The page is
 * served at arbitrary paths (and is locale-agnostic by nature), so it stays
 * outside BaseLayout: styles are self-contained, links are base-absolute,
 * and the copy is bilingual inline. The locale detect script redirects to
 * the visitor's language after a short beat so the page can be seen.
 */
import { buildLocaleDetectScript } from '@/lib/i18n/inline-scripts';
import { NO_FLASH_SCRIPT } from '@/lib/theme/no-flash';
import '@/styles/tokens.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — WebCraft</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline set:html={NO_FLASH_SCRIPT} />
    <script is:inline set:html={buildLocaleDetectScript(base, 2400)} />
  </head>
  <body>
    <main class="nf">
      <p class="nf__brand">Web<span>Craft</span>_</p>
      <div class="nf__window">
        <div class="nf__titlebar">
          <span class="nf__dot"></span>
          <span class="nf__dot"></span>
          <span class="nf__dot"></span>
          <span class="nf__title">webcraft — 404</span>
        </div>
        <div class="nf__screen">
          <p class="nf__line"><span class="nf__prompt">$</span> GET {base}<span class="nf__path">…</span></p>
          <p class="nf__line nf__line--error">404: page not found<span class="nf__cursor">▊</span></p>
          <p class="nf__note">
            The page you are looking for does not exist.<br />
            你访问的页面不存在。
          </p>
          <p class="nf__redirect">→ redirecting to your language… / 正在跳转…</p>
          <p class="nf__links">
            <a href={`${base}en/`}>English</a>
            <span aria-hidden="true">·</span>
            <a href={`${base}zh-CN/`}>简体中文</a>
          </p>
        </div>
      </div>
    </main>
    <noscript>
      <p class="nf__noscript">
        <a href={`${base}en/`}>English</a> · <a href={`${base}zh-CN/`}>简体中文</a>
      </p>
    </noscript>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background-color: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface);
    font-family: var(--md-sys-typescale-font);
  }

  .nf {
    width: min(34rem, 100%);
  }

  .nf__brand {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nf__brand span {
    color: var(--md-sys-color-primary);
  }

  .nf__window {
    border: var(--app-border-strong-width) solid var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-md);
    background-color: #16181d;
    box-shadow: var(--md-elev-3);
    overflow: hidden;
  }

  .nf__titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border-block-end: 1px solid #33363d;
  }

  .nf__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background-color: #3f434b;
  }

  .nf__dot:first-child {
    background-color: #a53a30;
  }

  .nf__dot:nth-child(2) {
    background-color: #8a5a00;
  }

  .nf__dot:nth-child(3) {
    background-color: #2b6a43;
  }

  .nf__title {
    margin-inline-start: auto;
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: #8e9199;
  }

  .nf__screen {
    padding: 1.5rem 1.25rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.7;
    color: #e2e3e7;
  }

  .nf__screen p {
    margin: 0 0 0.5rem;
  }

  .nf__prompt {
    color: #8fd4ae;
  }

  .nf__line--error {
    color: #ffb4a9;
    font-weight: 600;
  }

  .nf__cursor {
    display: inline-block;
    margin-inline-start: 0.15em;
    color: #8fd4ae;
    animation: nf-cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes nf-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__cursor {
      animation: none;
    }
  }

  .nf__note {
    margin-block-start: 1rem !important;
    font-family: var(--md-sys-typescale-font);
    color: #c3c6cd;
  }

  .nf__redirect {
    color: #8e9199;
    font-size: 0.85rem;
  }

  .nf__links {
    margin-top: 1rem !important;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .nf__links a {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid #44474e;
    border-radius: var(--md-sys-shape-corner-sm);
    color: #a8c2ff;
    text-decoration: none;
    transition: border-color 140ms ease;
  }

  .nf__links a:hover {
    border-color: #a8c2ff;
  }

  .nf__links span {
    color: #6d7076;
  }

  .nf__noscript {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline: 0;
    margin: 0;
    text-align: center;
    color: var(--md-sys-color-on-surface);
  }
</style>
