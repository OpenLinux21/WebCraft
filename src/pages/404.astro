---
import { buildLocaleDetectScript } from '@/lib/i18n/inline-scripts';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WebCraft</title>
    <meta name="robots" content="noindex" />
    <script is:inline set:html={buildLocaleDetectScript(base)} />
  </head>
  <body>
    <h1>404</h1>
    <noscript>
      <p>
        <a href={`${base}en/`}>English</a> · <a href={`${base}zh-CN/`}>简体中文</a>
      </p>
    </noscript>
  </body>
</html>
