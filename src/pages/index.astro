---
import { buildLocaleDetectScript } from '@/lib/i18n/inline-scripts';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WebCraft</title>
    <meta name="robots" content="noindex" />
    <script is:inline set:html={buildLocaleDetectScript()} />
  </head>
  <body>
    <noscript>
      <p>
        <a href="./en/">English</a> · <a href="./zh-CN/">简体中文</a>
      </p>
    </noscript>
  </body>
</html>
