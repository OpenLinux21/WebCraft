---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLessons, lessonIdOf } from '@/lib/courses/server';
import { serializeJsonScript } from '@/lib/utils/json-script';
import { createTranslator, getDictionary } from '@/lib/i18n/core';
import { APP_LOCALES, type AppLocale } from '@/lib/i18n/types';
import { coursesPath, lessonPath, playgroundPath, relativeHref } from '@/lib/routes';
import '@/styles/pages.css';

export function getStaticPaths() {
  return APP_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
const from = Astro.url.pathname;
const lessons = await getLessons(locale);

interface HomeLesson {
  id: string;
  title: string;
  href: string;
}

const homeLessons: HomeLesson[] = lessons.map((lesson) => ({
  id: lessonIdOf(lesson),
  title: lesson.data.title,
  href: relativeHref(lessonPath(locale, lessonIdOf(lesson)), from),
}));
const firstLesson = homeLessons[0];

// Both locales run the English typewriter lines (product decision):
// the hero always types the same five sentences.
const staticTitle = getDictionary('en').home.typewriterLines[0] ?? t.t('home.heroTitle');
---

<BaseLayout locale={locale} title={t.t('meta.homeTitle')} description={t.t('meta.homeDescription')}>
  <section class="hero immersive-section" data-immersive>
    <h1 class="hero-title" data-typewriter data-locale={locale}>
      <span class="visually-hidden">{staticTitle}</span>
      <span aria-hidden="true" data-typewriter-text>
        {staticTitle}
      </span>
      <span class="hero-cursor" aria-hidden="true">
        |
      </span>
    </h1>
    <p>{t.t('home.heroSubtitle')}</p>
    <div class="hero__actions">
      <a class="btn btn--filled" href={relativeHref(coursesPath(locale), from)}>
        {t.t('home.ctaStart')}
      </a>
      <a class="btn btn--outlined" href={relativeHref(playgroundPath(locale), from)}>
        {t.t('home.ctaPlayground')}
      </a>
    </div>
  </section>

  <section aria-labelledby="features-title" class="immersive-section" data-immersive>
    <h2 class="section-title" id="features-title">
      {t.t('home.featuresTitle')}
    </h2>
    <div class="feature-grid">
      <article class="card">
        <h3>{t.t('home.featurePrivacyTitle')}</h3>
        <p>{t.t('home.featurePrivacyBody')}</p>
      </article>
      <article class="card">
        <h3>{t.t('home.featureStaticTitle')}</h3>
        <p>{t.t('home.featureStaticBody')}</p>
      </article>
      <article class="card">
        <h3>{t.t('home.featureAiTitle')}</h3>
        <p>{t.t('home.featureAiBody')}</p>
      </article>
    </div>
  </section>

  {firstLesson && (
    <section
      class="progress-card card immersive-section"
      aria-labelledby="progress-title"
      data-progress-card
      data-immersive
      data-locale={locale}
    >
      <h2 id="progress-title">{t.t('home.progressTitle')}</h2>
      <div class="progress-card__bar">
        <div data-progress-bar style="width: 0%" />
      </div>
      <p class="progress-card__meta">
        <span data-progress-summary>
          {t.t('home.progressSummary', { done: 0, total: homeLessons.length })}
        </span>
        <a data-progress-continue href={firstLesson.href}>
          {t.t('home.startFirst')}
        </a>
      </p>
      <script
        type="application/json"
        data-lessons-payload
        set:html={serializeJsonScript(homeLessons)}
      />
    </section>
  )}
</BaseLayout>

<script>
  // Home progress card: reads lesson progress from local storage.
  import { createTranslator, isAppLocale } from '@/lib/i18n/core';
  import { createProgressRepo } from '@/lib/storage/repos/progress';
  import { getStorage } from '@/lib/storage/storage';

  interface HomeLesson {
    id: string;
    title: string;
    href: string;
  }

  function isHomeLesson(value: unknown): value is HomeLesson {
    if (typeof value !== 'object' || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record['id'] === 'string' &&
      typeof record['title'] === 'string' &&
      typeof record['href'] === 'string'
    );
  }

  async function initProgressCard(): Promise<void> {
    const card = document.querySelector<HTMLElement>('[data-progress-card]');
    if (!card) return;
    const payload = card.querySelector<HTMLScriptElement>('[data-lessons-payload]');
    const localeRaw: unknown = card.dataset.locale;
    if (!payload || !isAppLocale(localeRaw)) return;

    let lessons: HomeLesson[] = [];
    try {
      const parsed: unknown = JSON.parse(payload.textContent ?? '[]');
      if (Array.isArray(parsed)) lessons = parsed.filter(isHomeLesson);
    } catch {
      return;
    }
    if (lessons.length === 0) return;

    const t = createTranslator(localeRaw);
    const repo = createProgressRepo(await getStorage());
    const progressMap = new Map((await repo.list()).map((entry) => [entry.key, entry.value]));

    const done = lessons.filter(
      (lesson) => progressMap.get(lesson.id)?.status === 'completed',
    ).length;
    const bar = card.querySelector<HTMLElement>('[data-progress-bar]');
    const summary = card.querySelector<HTMLElement>('[data-progress-summary]');
    const continueLink = card.querySelector<HTMLAnchorElement>('[data-progress-continue]');
    if (bar) bar.style.width = `${Math.round((done / lessons.length) * 100)}%`;
    if (summary) summary.textContent = t.t('home.progressSummary', { done, total: lessons.length });
    if (continueLink) {
      const next = lessons.find((lesson) => progressMap.get(lesson.id)?.status !== 'completed');
      if (next) {
        continueLink.href = next.href;
        continueLink.textContent = t.t('home.continueLearning', { title: next.title });
      }
    }
  }

  void initProgressCard();
</script>

<script>
  // Immersive home scrolling: inertia via Lenis on desktop + scroll-snap
  // to sections. Skipped entirely for reduced-motion users; touch devices
  // rely on native momentum + CSS snap.
  async function initImmersive(): Promise<void> {
    const isHome = Boolean(document.querySelector('[data-immersive]'));
    if (!isHome) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.documentElement.dataset.immersive = 'true';

    const sections = [...document.querySelectorAll<HTMLElement>('[data-immersive]')];
    // Reveal-on-scroll animation (IO + CSS transition, no extra dependency).
    const revealer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        }
      },
      { threshold: 0.25 },
    );
    for (const section of sections) revealer.observe(section);

    // Compact layout: sections are content-sized, so there is nothing to
    // snap to — Lenis only provides the smooth inertia.
    const { default: Lenis } = await import('lenis');
    const lenis = new Lenis({ duration: 0.9, smoothWheel: true });
    const root = document.documentElement;
    root.dataset.lenisReady = 'true';

    const raf = (time: number): void => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  void initImmersive();
</script>

<script>
  // Human-feel typewriter for the hero on every locale (English lines).
  // Timing: type 60-120 ms/char (longer around punctuation and spaces),
  // hold 1-1.8 s per sentence, erase at 30-70 ms/char, breathe 0.3-0.6 s.
  // prefers-reduced-motion users get the static first line, no cursor.
  import { getDictionary, isAppLocale } from '@/lib/i18n/core';

  async function initTypewriter(): Promise<void> {
    const host = document.querySelector<HTMLElement>('[data-typewriter]');
    if (!host) return; // non-English locales keep the static title
    const localeRaw: unknown = host.dataset.locale;
    if (!isAppLocale(localeRaw)) return;

    const textEl = host.querySelector<HTMLElement>('[data-typewriter-text]');
    if (!textEl) return;

    // Both locales type the same English lines (product decision).
    const lines = getDictionary('en').home.typewriterLines;
    if (lines.length === 0) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      textEl.textContent = lines[0] ?? '';
      return; // static first line; the cursor is hidden by CSS
    }

    const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
    const rand = (min: number, max: number): number => min + Math.random() * (max - min);

    const typeLine = async (line: string): Promise<void> => {
      for (const ch of line) {
        textEl.textContent = (textEl.textContent ?? '') + ch;
        let delay = rand(60, 120);
        if (/[.,!?;:—]/.test(ch)) delay = rand(150, 300);
        else if (ch === ' ') delay += rand(0, 40);
        await sleep(delay);
      }
    };

    const eraseLine = async (): Promise<void> => {
      while ((textEl.textContent ?? '').length > 0) {
        textEl.textContent = (textEl.textContent ?? '').slice(0, -1);
        await sleep(rand(30, 70));
      }
    };

    // Hand the heading over to the animation from a blank slate.
    textEl.textContent = '';
    for (let index = 0; ; index += 1) {
      const line = lines[index % lines.length] ?? '';
      await typeLine(line);
      await sleep(rand(1000, 1800));
      await eraseLine();
      await sleep(rand(300, 600));
    }
  }

  void initTypewriter();
</script>
