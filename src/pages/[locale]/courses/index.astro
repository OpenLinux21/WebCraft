---
import { getLessons, lessonIdOf } from '@/lib/courses/server';
import { COURSE_MODULES } from '@/lib/courses/schema';
import { createTranslator } from '@/lib/i18n/core';
import { APP_LOCALES, type AppLocale } from '@/lib/i18n/types';
import { lessonPath, relativeHref } from '@/lib/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/pages.css';
import '@/styles/courses.css';

export function getStaticPaths() {
  return APP_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
const from = Astro.url.pathname;
const lessons = await getLessons(locale);

const groups = COURSE_MODULES.map((module) => ({
  module,
  entries: lessons.filter((lesson) => lesson.data.module === module),
}));
---

<BaseLayout
  locale={locale}
  title={t.t('meta.coursesTitle')}
  description={t.t('meta.coursesDescription')}
>
  <h1 class="page-title" data-motion="rise">{t.t('courses.title')}</h1>
  <p class="page-subtitle" data-motion="rise" style="--motion-index: 1">
    {t.t('courses.subtitle')}
  </p>

  {groups.map(({ module, entries }) =>
    entries.length > 0 ? (
      <section aria-labelledby={`module-${module}`}>
        <h2 class="module-title" id={`module-${module}`}>
          {t.t(`courses.moduleNames.${module}`)}
          <span class="module-title__count">
            {t.t('courses.lessonsInModule', { count: entries.length })}
          </span>
        </h2>
        <ol class="course-list">
          {entries.map((entry) => (
            <li class="course-list__item">
              <a
                class="course-list__link"
                href={relativeHref(lessonPath(locale, lessonIdOf(entry)), from)}
              >
                <span class="course-list__order" aria-hidden="true">
                  {entry.data.order}
                </span>
                <span class="course-list__text">
                  <strong>{entry.data.title}</strong>
                  <small>{entry.data.summary}</small>
                </span>
                <span class="course-list__meta">
                  <span
                    class="course-list__status"
                    data-lesson-progress-badge
                    data-lesson-id={lessonIdOf(entry)}
                  ></span>
                  {t.t(`courses.difficulty.${entry.data.difficulty}`)} ·{' '}
                  {t.t('common.minutesShort', { minutes: entry.data.minutes })}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ) : null,
  )}
</BaseLayout>

<script>
  // Fill per-lesson progress badges from local storage.
  import { createTranslator, localeFromLanguageTag } from '@/lib/i18n/core';
  import { createProgressRepo } from '@/lib/storage/repos/progress';
  import { getStorage } from '@/lib/storage/storage';
  import { onPageLoad } from '@/lib/ui/lifecycle';

  async function initProgressBadges(): Promise<void> {
    const badges = document.querySelectorAll<HTMLElement>('[data-lesson-progress-badge]');
    if (badges.length === 0) return;
    const t = createTranslator(localeFromLanguageTag(document.documentElement.lang));
    const repo = createProgressRepo(await getStorage());
    const progressMap = new Map((await repo.list()).map((entry) => [entry.key, entry.value]));

    for (const badge of badges) {
      const lessonId = badge.dataset.lessonId ?? '';
      const progress = lessonId ? progressMap.get(lessonId) : undefined;
      if (!progress || progress.status === 'notStarted') continue;
      badge.dataset.status = progress.status;
      badge.textContent = t.t(`courses.status.${progress.status}`);
    }
  }

  onPageLoad(() => void initProgressBadges());
</script>
