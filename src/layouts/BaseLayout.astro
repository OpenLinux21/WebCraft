---
import AppFooter from '@/components/AppFooter.astro';
import GlobalAiOverlay from '@/components/GlobalAiOverlay.astro';
import AppHeader from '@/components/AppHeader.astro';
import { ClientRouter } from 'astro:transitions';
import { createTranslator } from '@/lib/i18n/core';
import { HTML_LANG, type AppLocale } from '@/lib/i18n/types';
import { NO_FLASH_SCRIPT } from '@/lib/theme/no-flash';
// Self-hosted IBM Plex (latin subsets, bundled by Vite): zero third-party
// requests, works offline. Chinese text falls back to the system stacks in
// tokens.css.
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/material.css';

interface Props {
  locale: AppLocale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = createTranslator(locale);
const themeColorLight = '#f2f3f5';
const themeColorDark = '#131519';
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColorLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColorDark} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ClientRouter />
    <script is:inline set:html={NO_FLASH_SCRIPT} />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">
      {t.t('common.skipToContent')}
    </a>
    <AppHeader locale={locale} />
    <main id="main-content" class="app-main app-container">
      <slot />
    </main>
    <AppFooter locale={locale} />
    <GlobalAiOverlay locale={locale} />
    <script>
      // Shared-AI mode: pick up a publisher-provided tutor config if present.
      import { bootSharedAI } from '@/lib/ai/shared';
      void bootSharedAI();
    </script>
    <script>
      // ClientRouter glue: everything here runs once per session and stays
      // alive across client-side navigations via the astro:* events.
      import { onPageLoad } from '@/lib/ui/lifecycle';
      import { LOCALE_STORAGE_KEY } from '@/lib/i18n/inline-scripts';
      import { getResolvedTheme } from '@/lib/theme/theme';

      // Inline head scripts do not re-run after a swap, so the freshly
      // swapped-in <html> loses the `js` class and the resolved theme.
      // Re-apply both before the first post-navigation paint.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
        document.documentElement.dataset.theme = getResolvedTheme();
      });

      // Scroll progress bar (native scrollbars are hidden site-wide).
      const initScrollProgress = (): (() => void) => {
        const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
        if (!progressBar) return () => {};
        const update = (): void => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progressBar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        return () => {
          window.removeEventListener('scroll', update);
          window.removeEventListener('resize', update);
        };
      };
      onPageLoad(initScrollProgress);

      // Remember the last visited locale so the root page can redirect there
      // (was a per-render inline script, which cannot survive client-side
      // navigation — and the locale CAN change client-side via the switcher).
      document.addEventListener('astro:page-load', () => {
        try {
          localStorage.setItem(LOCALE_STORAGE_KEY, document.documentElement.lang);
        } catch {
          /* storage unavailable: browser-language detection still works */
        }
      });

      // Shared entrance system: reveal [data-motion~="rise"] elements with a
      // per-element stagger (see base.css). Rebound per page; reduced-motion
      // users get everything visible immediately.
      let revealer: IntersectionObserver | null = null;
      const initDataMotion = (): void => {
        revealer?.disconnect();
        revealer = null;
        const targets = document.querySelectorAll<HTMLElement>('[data-motion~="rise"]');
        if (targets.length === 0) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          for (const target of targets) target.classList.add('is-visible');
          return;
        }
        revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              revealer?.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
        );
        for (const target of targets) revealer.observe(target);
      };
      onPageLoad(initDataMotion);
    </script>
  </body>
</html>
